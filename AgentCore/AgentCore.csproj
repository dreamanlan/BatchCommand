<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AgentCore</RootNamespace>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- Include node drivers for all platforms (darwin-arm64/x64, linux-arm64/x64, win32_x64) so Mac deployment works out-of-the-box. -->
    <PlaywrightPlatform>all</PlaywrightPlatform>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.Diagnostics.Debugger.IsSupported" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Esprima" Version="3.0.5" />
    <PackageReference Include="TextCopy" Version="6.2.1" />

    <!-- Roslyn for C# code analysis and refactoring -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.8.0" />

    <!-- MSBuild for project management -->
    <PackageReference Include="Microsoft.Build" Version="17.8.3" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Locator" Version="1.6.10" />

    <!-- NuGet for package management -->
    <PackageReference Include="NuGet.Protocol" Version="6.8.0" />
    <PackageReference Include="NuGet.Packaging" Version="6.8.0" />
    <PackageReference Include="Tokenizers.DotNet" Version="1.4.0" />
    <PackageReference Include="Tokenizers.DotNet.runtime.win-x64" Version="1.4.0" />
    <PackageReference Include="Tokenizers.DotNet.runtime.win-arm64" Version="1.4.0" />
    <PackageReference Include="Tokenizers.DotNet.runtime.linux-x64" Version="1.4.0" />
    <PackageReference Include="Tokenizers.DotNet.runtime.linux-arm64" Version="1.4.0" />
    <PackageReference Include="Tokenizers.DotNet.runtime.osx-x64" Version="1.4.0" />
    <PackageReference Include="Tokenizers.DotNet.runtime.osx-arm64" Version="1.4.0" />

    <!-- Tree-sitter for multi-language code parsing -->
    <PackageReference Include="TreeSitter.DotNet" Version="1.3.0" />

    <!-- Jint for JavaScript code parsing and execution -->
    <PackageReference Include="Jint" Version="4.2.0" />

    <!-- Playwright for browser automation (headed persistent context for Google/Cloudflare-protected sites) -->
    <PackageReference Include="Microsoft.Playwright" Version="1.47.0" />

    <!-- ONNX Runtime for embedding inference -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />

    <!-- Tokenizer for BERT-based models -->
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />

    <!-- SQLite for persistent storage -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />

    <!-- Lucene.Net for BM25 bag-of-words search -->
    <PackageReference Include="Lucene.Net" Version="4.8.0-beta00016" />
    <PackageReference Include="Lucene.Net.Analysis.Common" Version="4.8.0-beta00016" />
    <PackageReference Include="Lucene.Net.Codecs" Version="4.8.0-beta00016" />
    <PackageReference Include="Lucene.Net.QueryParser" Version="4.8.0-beta00016" />

    <!-- ML.NET for TF-IDF search -->
    <PackageReference Include="Microsoft.ML" Version="3.0.1" />

    <!-- jieba.NET for Chinese word segmentation -->
    <PackageReference Include="jieba.NET" Version="0.42.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude test files that have compilation errors -->
    <Compile Remove="Test\*.cs" />
    <Compile Remove="Tests\TreeSitterApiTest.cs" />
    <Compile Remove="Tests\JavaScriptParserQuickTest.cs" />
    <!-- Exclude standalone test project to avoid AssemblyInfo conflicts -->
    <Compile Remove="Tests\TreeSitterPythonTest\**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Common">
      <HintPath>..\deps\Common.dll</HintPath>
    </Reference>
    <Reference Include="DotnetStoryScript">
      <HintPath>..\deps\DotnetStoryScript.dll</HintPath>
    </Reference>
    <Reference Include="Dsl">
      <HintPath>..\deps\Dsl.dll</HintPath>
    </Reference>
    <Reference Include="LitJson">
      <HintPath>..\deps\LitJson.dll</HintPath>
    </Reference>
    <Reference Include="ScriptFrameworkLibrary">
      <HintPath>..\deps\ScriptFrameworkLibrary.dll</HintPath>
    </Reference>
    <!-- WinRT projections (deps, from the Microsoft.Windows.SDK.NET.Ref
         10.0.26100.87 nupkg): not referenced by our code, but TextCopy's
         clipboard implementation probes for these at runtime. Referenced so
         CopyLocal brings them into the bin output; copy.dsl deploys them. -->
    <Reference Include="Microsoft.Windows.SDK.NET">
      <HintPath>..\deps\Microsoft.Windows.SDK.NET.dll</HintPath>
    </Reference>
    <Reference Include="WinRT.Runtime">
      <HintPath>..\deps\WinRT.Runtime.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Deploy jieba.NET dictionary resources (dict.txt, prob_*.json, pos_prob_*.json) to the
         output so they are available at runtime under managed/Resources (ConfigManager.ConfigFileBaseDir). -->
    <Content Include="$(NuGetPackageRoot)jieba.net\*\Resources\**\*">
      <Link>Resources\%(RecursiveDir)%(FileName)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>false</Pack>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BatchScriptApi\BatchScriptApi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BatchCmdDslHost\BatchCmdDsl\BatchCmdDsl.csproj" />
  </ItemGroup>

  <!-- Deploy AgentCore.* to the WebAgent managed dir after build, mirroring
       the BatchCmdDsl csproj pattern (copy.dsl does the actual copying). -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="$(ProjectDir)..\bin\Debug\net9.0\BatchCommand.exe $(ProjectDir)copy.dsl bat" />
  </Target>

</Project>
